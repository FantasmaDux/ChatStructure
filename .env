# auth
AUTH_POSTGRES_DB_HOST=auth-db-postgres
AUTH_POSTGRES_DB_EXTERNAL_PORT=5555
AUTH_POSTGRES_DB_INTERNAL_PORT=5432
AUTH_POSTGRES_DB_NAME=auth-micro-db
AUTH_POSTGRES_DB_USER=postgres
AUTH_POSTGRES_DB_PASSWORD=postgres
AUTH_PGSSLMODE_STATUS=disable

HTTP_PORT=80
HTTPS_PORT=443
GRPC_PORT=9090

JWT_SECRET=my-super-secret-key
JWT_ACCESS_EXPIRATION=15
JWT_REFRESH_EXPIRATION=10080

# network
NETWORKING_POSTGRES_DB_HOST=networking-db-postgres
NETWORKING_POSTGRES_DB_EXTERNAL_PORT=5434
NETWORKING_POSTGRES_DB_INTERNAL_PORT=5432
NETWORKING_POSTGRES_DB_NAME=networking-micro-db
NETWORKING_POSTGRES_DB_USER=postgres
NETWORKING_POSTGRES_DB_PASSWORD=postgres
NETWORKING_PGSSLMODE_STATUS=disable

# healthcheck
HEALTHCHECK_INTERVAL=1s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=10
